MODULE ProjectNotificationStendex;

REQUIRE ProjectKanbanStendex, EmployeeNotificationStendex, NotificationsStendex;

NAMESPACE ProjectManagement;

baseProjectUrl 'Базовый URL приложения' = DATA STRING();

EXTEND FORM options
    PROPERTIES() baseProjectUrl
;

DESIGN options {
    commons {
        MOVE PROPERTY(baseProjectUrl());
    }
}

projectLink (Project p) = baseProjectUrl() + '/exec/ProjectManagement.showProjectId?id=' + STRING(LONG(p));

EXTEND CLASS Notifications.TypeEmailNotification {
    pendingProject 'Новый проект (ожидание утверждения)',
    approvedProject 'Проект утвержден'
}

titleNotification (Notifications.TypeEmailNotification en) = CASE
    WHEN en == Notifications.TypeEmailNotification.pendingProject THEN 'Новый проект ожидает утверждения'
    WHEN en == Notifications.TypeEmailNotification.approvedProject THEN 'Проект утвержден';

CLASS ProjectNotification 'Уведомления о проектах';

project = DATA Project (ProjectNotification);
employeeToNotify = DATA Employee (ProjectNotification);
nameEmployeeToNotify 'Кого уведомить' (ProjectNotification pn) = name(employeeToNotify(pn));
typeNotification = DATA Notifications.TypeEmailNotification (ProjectNotification);
nameTypeNotification 'Тип' (ProjectNotification pn) = Notifications.name(typeNotification(pn));
dateTimeNotification 'Дата и время' = DATA DATETIME (ProjectNotification) CHARWIDTH 15;
sentSystemDateTime 'Отправлено\n(система)' = DATA DATETIME (ProjectNotification) CHARWIDTH 15;
sentEmailDateTime 'Отправлено\n(почта)' = DATA DATETIME (ProjectNotification) CHARWIDTH 15;

countNotifications (Project p) = GROUP SUM 1 IF project(ProjectNotification pn) = p;
numberReadonly 'Номер проекта' (Project p) = number(p);

condionSendEmail = ABSTRACT VALUE BOOLEAN (Notifications.TypeEmailNotification, Project, Employee);

condionSendEmail(Notifications.TypeEmailNotification en, Project p, Employee e) +=
    canConfirmNewProject(e) AND p IS Project AND en == Notifications.TypeEmailNotification.pendingProject;

condionSendEmail(Notifications.TypeEmailNotification en, Project p, Employee e) +=
    (manager(p) = e OR designer(p) = e) AND en == Notifications.TypeEmailNotification.approvedProject;

bodyHtmlProject (ProjectNotification pn) = HTMLTEXT(CONCAT '',
    '<h1>' + titleNotification(typeNotification(pn)) + '</h1>',
    '<p><b>Проект:</b> ' + name(project(pn)) + '</p>',
    '<p><b>Менеджер:</b> ' + nameManager(project(pn)) + '</p>',
    '<p><b>Дизайнер:</b> ' + nameDesigner(project(pn)) + '</p>',
    '<p><b>Клиент:</b> ' + namePartner(project(pn)) + '</p>',
    '<p><b>Компания:</b> ' + nameCompany(project(pn)) + '</p>',
    '<br>',
    '<p><a href="' + projectLink(project(pn)) +
        '" style="display:inline-block;padding:12px 24px;background-color:#007bff;color:white;text-decoration:none;border-radius:5px;font-weight:bold;">Открыть проект</a></p>');

subjectProject (ProjectNotification pn) = titleNotification(typeNotification(pn)) + ': ' + name(project(pn));

notificationMessageSimple (ProjectNotification pn) = CONCAT '\n',
    titleNotification(typeNotification(pn)),
    'Проект: ' + name(project(pn)),
    'Менеджер: ' + nameManager(project(pn)),
    'Дизайнер: ' + nameDesigner(project(pn)),
    'Клиент: ' + namePartner(project(pn)),
    'Компания: ' + nameCompany(project(pn));

showProject 'Открыть проект' (Project p) {
    SHOW project OBJECTS p = p DOCKED;
}

showProjectId 'Открыть проект' (LONG id) {
    showProject(GROUP MAX Project p AS Project IF LONG(p) = id);
}

FORM openProject 'Уведомление'
    OBJECTS s = STRING PANEL
    PROPERTIES READONLY notifi = TEXT(s)
    OBJECTS p = Project
    PROPERTIES(p) showProject
;

DESIGN openProject {
    BOX(p) { caption = ''; }
    BOX(s) { caption = ''; }
    OBJECTS {
        MOVE PROPERTY(notifi);
        PROPERTY(notifi) { caption = ''; alignment = STRETCH; valueHeight = 150; valueWidth = 300; }
    }
    MOVE PANEL AFTER OBJECTS {
        NEW horiz {
            horizontal = TRUE;
            MOVE PROPERTY(showProject(p)) { alignment = STRETCH; fill = 1; valueClass = 'btn-primary'; }
            MOVE PROPERTY(formClose()) { alignment = STRETCH; fill = 1; }
        }
    }
    REMOVE TOOLBAR;
    REMOVE TOOLBARLEFT;
    REMOVE PROPERTY(formOk());
    REMOVE PROPERTY(formRefresh());
}

sendEmailByNotification (ProjectNotification pn) {
    EMAIL
        SUBJECT subjectProject(pn)
        TO email[Contact](employeeToNotify(pn))
        BODY bodyHtmlProject(pn);
}

notifyUserEmailProject 'Отправить на почту' (ProjectNotification pn) {
    sendEmailByNotification(pn);
    sentEmailDateTime(pn) <- currentDateTime();
    APPLY;
}

sendNotificationProject (ProjectNotification pn) {
    FOR Connection c IS Connection AND connectionStatus(c) = ConnectionStatus.connectedConnection
        AND user(c) = employeeToNotify(pn) DO {
        IF pushConnection(employeeToNotify(pn)) THEN {
            NEWSESSION {
                NEWTHREAD {
                    SHOW openProject OBJECTS p = project(pn), s = notificationMessageSimple(pn) FLOAT;
                } CONNECTION c;
            }
        }
    }
    sentSystemDateTime(pn) <- currentDateTime();
}

Notifications.sendNotification(DATETIME dTFrom) + {
    FOR dateTimeNotification(ProjectNotification pn) >= dTFrom
        AND dateTimeNotification(pn) <= currentDateTime()
        AND NOT sentSystemDateTime(pn) DO {
        sendNotificationProject(pn);
    }
}

hasUnsentEmail (Notifications.TypeEmailNotification en, Project p) =
    TRUE IF (GROUP SUM 1 IF project(ProjectNotification pn) = p AND typeNotification(pn) = en AND NOT sentEmailDateTime(pn));

sendEmailNotificationProject (Notifications.TypeEmailNotification en, Project p) {
    FOR project(ProjectNotification pn) = p AND typeNotification(pn) = en AND NOT sentEmailDateTime(pn) DO {
        sendEmailByNotification(pn);
        sentEmailDateTime(pn) <- currentDateTime();
    }
    APPLY;
}

condionSendEmail = ABSTRACT VALUE BOOLEAN (Notifications.TypeEmailNotification, Project);

condionSendEmail(Notifications.TypeEmailNotification en, Project p) +=
    hasUnsentEmail(en, p)
        AND (en == Notifications.TypeEmailNotification.pendingProject OR en == Notifications.TypeEmailNotification.approvedProject);

Notifications.sendEmailNotification(DATE dFrom) + {
    FOR condionSendEmail(Notifications.TypeEmailNotification en, Project p)
        DO sendEmailNotificationProject(en, p);
}

FORM selectDesigner 'Выбор дизайнера'
    OBJECTS e = Individual
    PROPERTIES(e) READONLY name
    FILTERS isDesigner(position(e))
;

approveProject 'Утвердить' (Project p) {
    DIALOG selectDesigner OBJECTS e INPUT DO {
        designer(p) <- e;
        status(p) <- projectStatus('approved');
        APPLY;
    }
} IMAGE 'ok' CHARWIDTH 10;

onOpenProject (Project p) {
    IF manager(p) = currentUser() AND status(p) = projectStatus('approved') THEN {
        NEWSESSION {
            status(p) <- projectStatus('infoCollection');
            APPLY;
        }
    }
}

createProjectNotification (Notifications.TypeEmailNotification en, Project p, Employee e) {
    NEW pn = ProjectNotification {
        project(pn) <- p;
        employeeToNotify(pn) <- e;
        typeNotification(pn) <- en;
        dateTimeNotification(pn) <- currentDateTime();
    }
}

WHEN SET(Project p IS Project) AND status(p) = projectStatus('pending') DO {
    FOR Notifications.notifite(Notifications.TypeEmailNotification.pendingProject, Employee e)
        AND condionSendEmail(Notifications.TypeEmailNotification.pendingProject, p, e) DO
        createProjectNotification(Notifications.TypeEmailNotification.pendingProject, p, e);
}

WHEN SETCHANGED(status(Project p)) AND status(p) = projectStatus('approved') DO {
    FOR Notifications.notifite(Notifications.TypeEmailNotification.approvedProject, Employee e)
        AND condionSendEmail(Notifications.TypeEmailNotification.approvedProject, p, e) DO
        createProjectNotification(Notifications.TypeEmailNotification.approvedProject, p, e);
}

EXTEND FORM project
    PROPERTIES(p) READONLY numberReadonly
    PROPERTIES(p) approveProject

    OBJECTS pn = ProjectNotification
    PROPERTIES(pn) READONLY nameEmployeeToNotify, nameTypeNotification, dateTimeNotification, sentSystemDateTime, sentEmailDateTime
    PROPERTIES(pn) notifyUserEmailProject SHOWIF NOT sentEmailDateTime(pn)
    PROPERTIES(pn) NEW, DELETE
    FILTERS project(pn) = p

    EVENTS
        ON INIT onOpenProject(p)
;

DESIGN project {
    statusPane {
        NEW numberPane FIRST {
            MOVE PROPERTY(numberReadonly(p)) { font = 'bold 14'; }
        }
    }
    REMOVE PROPERTY(number(p));
    details {
        NEW approvalTab FIRST {
            caption = 'Согласование';
            showIf = canConfirmNewProject(currentUser()) AND status(p) = projectStatus('pending');
            MOVE PROPERTY(approveProject(p)) { alignment = STRETCH; font = 'bold 14'; valueClass = 'btn-success'; }
        }
        MOVE BOX(pn) { caption = badged('Уведомления', countNotifications(p)); }
    }
    PROPERTY(notifyUserEmailProject(pn)) { valueClass = 'btn-warning'; }
}

EXTEND FORM projects
    PROPERTIES(pending) GRID approveProject SHOWIF canConfirmNewProject(currentUser())
;

DESIGN projects {
    PROPERTY(approveProject(pending)) { valueClass = 'btn-success'; }
}

FORM projectNotifications 'Журнал уведомлений проектов'
    OBJECTS dates = (from = DATETIME, to = DATETIME) PANEL
    PROPERTIES valFrom = VALUE(from), valTo = VALUE(to)

    OBJECTS pn = ProjectNotification LAST
    PROPERTIES(pn) READONLY nameEmployeeToNotify, nameTypeNotification, dateTimeNotification, sentSystemDateTime, sentEmailDateTime
    FILTERS sentSystemDateTime(pn) OR sentEmailDateTime(pn)
    FILTERS dateTimeNotification(pn) >= from AND dateTimeNotification(pn) <= to
    EVENTS
        ON INIT {
            SEEK projectNotifications.dates OBJECTS from = dateTimeToDateTime(currentDate(), 00:00), to = currentDateTime();
        }
;

NAVIGATOR {
    logs {
        NEW projectNotifications;
    }
}